@page "/login"
@inject SecurityService SecurityService
@inject NavigationManager Navigation

<PageTitle>Login - Daily Log</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm border-0 animate-fade-in" style="max-width: 400px; width: 100%;">
        <div class="card-body p-5 text-center">
            <div class="mb-4">
                <span class="display-4">🔐</span>
                <h2 class="fw-bold mt-3">Private Access</h2>
                <p class="text-muted">Please enter your password to unlock your daily log.</p>
            </div>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger small mb-4 py-2">@errorMessage</div>
            }

            <EditForm Model="this" OnValidSubmit="SubmitLogin">
                <div class="mb-4 text-start">
                    <label class="form-label small fw-bold">Password</label>
                    <input type="password" 
                           class="form-control form-control-lg text-center" 
                           @bind="password" 
                           placeholder="••••" 
                           required 
                           autofocus />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 mt-2 fw-bold shadow-sm">
                    Unlock Daily Log
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private string password = "";
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        if (SecurityService.IsAuthenticated)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    private async Task SubmitLogin()
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter your password.";
            return;
        }

        if (await SecurityService.LoginAsync(password))
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = "Incorrect password. Please try again.";
            password = "";
        }
    }
}
