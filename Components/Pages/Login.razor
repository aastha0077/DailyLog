@page "/login"
@inject SecurityService SecurityService
@inject NavigationManager Navigation

<PageTitle>Login - My Journals</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow border-0" style="max-width: 400px; width: 100%;">
        <div class="card-body p-5 text-center">
            <h2 class="fw-bold mb-4">Secure Access</h2>
            
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger small mb-4">@errorMessage</div>
            }

            <div class="mb-4">
                <input type="password" 
                       class="form-control text-center fs-2" 
                       @bind="pinInput" 
                       maxlength="6" 
                       placeholder="••••••" />
            </div>

            <button class="btn btn-primary w-100 py-3" @onclick="SubmitLogin">
                Unlock
            </button>
        </div>
    </div>
</div>

@code {
    private string pinInput = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        bool isProtected = await SecurityService.IsProtectedAsync();
        if (!isProtected)
        {
            SecurityService.Authenticate();
            Navigation.NavigateTo("/dashboard");
        }
    }

    private async Task SubmitLogin()
    {
        if (pinInput.Length != 6)
        {
            errorMessage = "Please enter 6 digits.";
            return;
        }

        if (await SecurityService.VerifyPINAsync(pinInput))
        {
            SecurityService.Authenticate();
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = "Invalid PIN.";
            pinInput = "";
        }
    }
}
