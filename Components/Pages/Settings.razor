@page "/settings"
@inject SecurityService SecurityService
@inject NavigationManager Navigation

<PageTitle>Settings - Daily Log</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-outline-secondary me-3" @onclick='() => Navigation.NavigateTo("/dashboard")'>
                    ← Back
                </button>
                <h1 class="mb-0">Settings</h1>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                     <h2 class="h5 mb-0 fw-bold">Appearance</h2>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-1">Theme</h5>
                            <p class="text-muted small mb-0">Customize the look and feel.</p>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" value="@currentTheme" @onchange="ChangeTheme">
                                <option value="Light">Light Mode</option>
                                <option value="Dark">Dark Mode</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h2 class="h5 mb-0 fw-bold">Security & Privacy</h2>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-1">PIN Protection</h5>
                            <p class="text-muted small mb-0">Lock your daily log with a 6-digit code.</p>
                        </div>
                        <div class="col-md-4 text-end">
                            @if (userSettings.IsProtected)
                            {
                                <button class="btn btn-outline-primary me-2" @onclick="ShowPINDialog">Change PIN</button>
                                <button class="btn btn-outline-danger me-2" @onclick="DisableProtection">Disable</button>
                                <button class="btn btn-dark" @onclick="Logout">Lock Now</button>
                            }
                            else
                            {
                                <button class="btn btn-primary px-4" @onclick="ShowPINDialog">Set PIN</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                     <h2 class="h5 mb-0 fw-bold">Data Management</h2>
                </div>
                <div class="card-body">
                    <h5 class="mb-2">Export Journals</h5>
                    <p class="text-muted small mb-4">Download your daily log as a PDF document.</p>
                    
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Start Date</label>
                            <input type="date" class="form-control" @bind="exportStartDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">End Date</label>
                            <input type="date" class="form-control" @bind="exportEndDate" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100" @onclick="ExportPdf" disabled="@isExporting">
                                @if(isExporting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                Export to PDF
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(exportMessage))
                    {
                        <div class="mt-3 alert @(exportSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                            <i class="bi @(exportSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                            @exportMessage
                            <button type="button" class="btn-close" @onclick="() => exportMessage = null"></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showPINDialog)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" @onclick="CloseDialog">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">PIN Setup</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body py-4">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="alert @(statusMessage.Contains("Success") ? "alert-success" : "alert-info") small animate-fade-in">
                            <i class="bi @(statusMessage.Contains("Success") ? "bi-check-circle-fill" : "bi-info-circle-fill") me-2"></i>
                            @statusMessage
                        </div>
                    }
                    <div class="mb-3 text-center">
                        <label class="form-label small fw-bold">Enter 4-6 digit PIN</label>
                        <input type="password" class="form-control form-control-lg text-center" 
                               @bind="newPIN" @bind:event="oninput" maxlength="6" 
                               placeholder="••••" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" @onclick="CloseDialog">Cancel</button>
                    <button type="button" class="btn btn-primary px-4" @onclick="SavePIN">Set PIN Now</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ExportService ExportService { get; set; } = default!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private UserSettings userSettings = new();
    private bool showPINDialog = false;
    private string newPIN = "";
    private string statusMessage = "";
    private string currentTheme = "Light";
    
    private string? exportMessage;
    private bool exportSuccess;
    
    private DateTime exportStartDate = DateTime.Today.AddMonths(-1);
    private DateTime exportEndDate = DateTime.Today;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        userSettings = await SecurityService.GetUserSettingsAsync();
        currentTheme = userSettings.Theme ?? "Light";
    }

    private async Task ChangeTheme(ChangeEventArgs e)
    {
        currentTheme = e.Value?.ToString() ?? "Light";
        await SecurityService.SetThemeAsync(currentTheme);
        await JSRuntime.InvokeVoidAsync("setTheme", currentTheme);
    }

    private async Task ExportPdf()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Export journal entries from {exportStartDate:yyyy-MM-dd} to {exportEndDate:yyyy-MM-dd} to PDF?");
        if (!confirmed) return;

        isExporting = true;
        exportMessage = null;
        try 
        {
            var path = await ExportService.ExportToPdfAsync(exportStartDate, exportEndDate);
            exportSuccess = true;
            exportMessage = $"Success! PDF saved to: {path}";
            
            await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync(new Microsoft.Maui.ApplicationModel.OpenFileRequest
            {
                File = new Microsoft.Maui.Storage.ReadOnlyFile(path)
            });
        }
        catch(Exception ex)
        {
            exportSuccess = false;
            exportMessage = $"Export failed: {ex.Message}";
        }
        finally { isExporting = false; }
    }

    private void ShowPINDialog()
    {
        showPINDialog = true;
        newPIN = "";
        statusMessage = "";
    }

    private void CloseDialog() => showPINDialog = false;

    private async Task SavePIN()
    {
        if (string.IsNullOrWhiteSpace(newPIN) || newPIN.Length < 4 || newPIN.Length > 6 || !int.TryParse(newPIN, out _))
        {
            statusMessage = "PIN must be 4-6 numeric digits.";
            return;
        }

        await SecurityService.SetPINAsync(newPIN);
        statusMessage = "Success! PIN updated.";
        StateHasChanged();
        
        await Task.Delay(1500); // Give user time to see success
        showPINDialog = false;
        userSettings = await SecurityService.GetUserSettingsAsync();
        newPIN = "";
    }

    private async Task DisableProtection()
    {
        await SecurityService.DisableProtectionAsync();
        userSettings = await SecurityService.GetUserSettingsAsync();
    }

    private void Logout()
    {
        SecurityService.Logout();
        Navigation.NavigateTo("/login");
    }
}
