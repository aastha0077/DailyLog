@page "/dashboard"
@inject AnalyticsService AnalyticsService
@inject SecurityService SecurityService
@inject NavigationManager Navigation
@inject MoodService MoodService
@using MyJournals.Components.Shared

<PageTitle>Dashboard - My Journals</PageTitle>

<div class="dashboard-container">
    <!-- Beautiful Header Section -->
    <div class="dashboard-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-4">
                        <div class="bg-gradient-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; box-shadow: 0 8px 24px rgba(13, 110, 253, 0.3);">
                            <i class="bi bi-speedometer2 text-white fs-1"></i>
                        </div>
                    </div>
                    <div>
                        <h1 class="h2 mb-2 fw-bold bg-gradient-primary bg-clip-text text-transparent">Welcome Back!</h1>
                        <p class="text-muted mb-0 fs-5">Here's your personal journaling overview</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="d-flex gap-3 justify-content-md-end">
                    <button class="btn btn-primary btn-lg px-4" @onclick='() => Navigation.NavigateTo("/entry")'>
                        <i class="bi bi-pencil-square me-2"></i>Add New Entry
                    </button>
                    <button class="btn btn-outline-primary btn-lg px-4" @onclick="RefreshData">
                        <i class="bi bi-arrow-clockwise me-2"></i>Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    @if (isLoading)
    {
        <LoadingSpinner Message="Loading your analytics..." />
    }
    else
    {
        <div class="dashboard-content">
            <!-- Enhanced Streak Section -->
            <DashboardCard Title="Journaling Streaks" Icon="fire" IconColor="warning">
                <div class="row g-3">
                    <div class="col-4">
                        <StatCard Value="@streakInfo.CurrentStreak.ToString()" Label="Current" Color="success" />
                    </div>
                    <div class="col-4">
                        <StatCard Value="@streakInfo.LongestStreak.ToString()" Label="Longest" Color="info" />
                    </div>
                    <div class="col-4">
                        <StatCard Value="@streakInfo.MissedDays.Count.ToString()" Label="Missed" Color="danger" />
                    </div>
                </div>
                @if (streakInfo.MissedDays.Any())
                {
                    <div class="mt-3">
                        <small class="text-muted">Recently missed: @string.Join(", ", streakInfo.MissedDays.Take(3).Select(d => d.ToString("MMM dd")))</small>
                    </div>
                }
            </DashboardCard>

            <!-- Enhanced Mood Distribution -->
            <DashboardCard Title="Mood Distribution" Icon="emoji-smile" IconColor="primary">
                @if (moodDistribution.Any())
                {
                    @foreach (var mood in moodDistribution)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold">
                                    <i class="bi bi-@MoodService.GetMoodIcon(mood.Category) text-@MoodService.GetMoodColor(mood.Category) me-1"></i>
                                    @mood.Category
                                </span>
                                <span class="badge bg-gradient-primary">@mood.Percentage.ToString("F1")%</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar bg-gradient-@GetBootstrapColor(mood.Category)" 
                                     role="progressbar"
                                     style="width: @(mood.Percentage)%; border-radius: 6px;" 
                                     aria-valuenow="@mood.Percentage" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                </div>
                            </div>
                            <small class="text-muted">@mood.Count entries</small>
                        </div>
                    }
                }
                else
                {
                    <EmptyState Icon="emoji-neutral" Message="No mood data available yet" />
                }
            </DashboardCard>

            <!-- Enhanced Most Frequent Mood -->
            @if (mostFrequentMood.HasValue)
            {
                <DashboardCard Title="Most Frequent Mood" Icon="star" IconColor="success">
                    <div class="text-center py-4">
                        <div class="bg-gradient-primary rounded-3 p-4 d-inline-block">
                            <span class="text-white fs-3 fw-bold">@mostFrequentMood.Value.ToString()</span>
                        </div>
                        <p class="mt-3 text-muted">This is your most common mood</p>
                    </div>
                </DashboardCard>
            }

            <!-- Enhanced Most Used Tags -->
            <DashboardCard Title="Most Used Tags" Icon="tags" IconColor="info">
                @if (mostUsedTags.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in mostUsedTags.Take(10))
                        {
                            <span class="badge bg-gradient-secondary fs-6 px-3 py-2">
                                @tag.Tag <span class="ms-1 badge bg-light text-dark">@tag.Count</span>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <EmptyState Icon="tags" Message="No tags used yet" />
                }
            </DashboardCard>

            <!-- Enhanced Word Count Trends -->
            <DashboardCard Title="Writing Statistics" Icon="graph-up" IconColor="warning">
                @if (wordCountTrends.Any())
                {
                    var avgWords = wordCountTrends.Last().AverageWordCount;
                    var totalWords = wordCountTrends.Sum(t => t.AverageWordCount);
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <StatCard Value="@avgWords.ToString("F0")" Label="Avg Words" Color="primary" />
                        </div>
                        <div class="col-6">
                            <StatCard Value="@wordCountTrends.Count.ToString()" Label="Total Entries" Color="success" />
                        </div>
                    </div>
                    <div class="mt-3 text-center">
                        <small class="text-muted">Total words written: @(totalWords.ToString("N0"))</small>
                    </div>
                }
                else
                {
                    <EmptyState Icon="pencil" Message="Start journaling to see your writing trends!" />
                }
            </DashboardCard>
        </div>
    }
</div>

@code {
    private StreakInfo streakInfo = new();
    private List<MoodDistribution> moodDistribution = new();
    private MoodType? mostFrequentMood;
    private List<TagUsage> mostUsedTags = new();
    private List<WordCountTrend> wordCountTrends = new();
    private bool isLoading = true;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("Dashboard page initialized");
            await LoadDashboardData();
            Console.WriteLine("Dashboard data loaded successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard initialization error: {ex.Message}");
            // Continue with empty state
        }
    }
    
    private async Task LoadDashboardData()
    {
        isLoading = true;
        try
        {
            streakInfo = await AnalyticsService.GetStreakInfoAsync();
            moodDistribution = await AnalyticsService.GetMoodDistributionAsync();
            mostFrequentMood = await AnalyticsService.GetMostFrequentMoodAsync();
            mostUsedTags = await AnalyticsService.GetMostUsedTagsAsync(10);
            wordCountTrends = await AnalyticsService.GetWordCountTrendsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
            // Set default values if analytics fail
            streakInfo = new StreakInfo { CurrentStreak = 0, LongestStreak = 0, MissedDays = new List<DateTime>() };
            moodDistribution = new List<MoodDistribution>();
            mostUsedTags = new List<TagUsage>();
            wordCountTrends = new List<WordCountTrend>();
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task RefreshData()
    {
        await LoadDashboardData();
    }

    private string GetBootstrapColor(MoodCategory category)
    {
        return category switch
        {
            MoodCategory.Positive => "success",
            MoodCategory.Neutral => "warning",
            MoodCategory.Negative => "danger",
            _ => "secondary"
        };
    }

}
