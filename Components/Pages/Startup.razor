@page "/startup"
@inject AppDatabase Database
@inject NavigationManager Navigation
@inject SecurityService SecurityService

<PageTitle>My Journals</PageTitle>

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-white">
    <div class="text-center p-4">
        <h1 class="display-5 fw-bold mb-3 text-primary">My Journals</h1>
        <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-secondary">@statusMessage</p>
    </div>
</div>

@code {
    private string statusMessage = "Starting up...";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RunInitialization();
        }
    }

    private async Task RunInitialization()
    {
        try
        {
            // Small delay to ensure UI renders
            await Task.Delay(100);
            
            statusMessage = "Setting up database...";
            StateHasChanged();
            await Database.InitializeAsync();
            
            statusMessage = "Loading settings...";
            StateHasChanged();
            await SecurityService.GetUserSettingsAsync();
            
            statusMessage = "Checking security...";
            StateHasChanged();
            
            if (await SecurityService.IsProtectedAsync())
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Auto-login for unprotected journals
                await SecurityService.LoginAsync("");
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"System error: {ex.Message}";
            StateHasChanged();
        }
    }
}
