@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SecurityService SecurityService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="app-container">
    @if (ShouldShowSidebar)
    {
        <aside class="sidebar">
            <NavMenu />
        </aside>
    }

    <main class="main-content @(ShouldShowSidebar ? "" : "full-width")">
        <div class="content-wrapper">
            @Body
        </div>
    </main>

    
</div>

@code {
    private bool ShouldShowSidebar 
    {
        get 
        {
            try 
            {
                var uri = Navigation.Uri.ToLower();
                if (uri.Contains("/login") || uri.Contains("/startup")) return false;
                
                var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
                return !string.IsNullOrEmpty(relativePath);
            }
            catch 
            {
                return false; 
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                var theme = await SecurityService.GetCurrentThemeAsync();
                await JSRuntime.InvokeVoidAsync("setTheme", theme);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[THEME] Failed to set theme on startup: {ex.Message}");
            }
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        CheckSecurity();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (CheckSecurity())
        {
            StateHasChanged();
        }
    }

    private bool CheckSecurity()
    {
        string? redirectTo = null;
        try 
        {
            var uri = Navigation.Uri.ToLower();
            // In some MAUI environments, ToBaseRelativePath can throw if base is unexpected
            string relativePath = "";
            try { relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower(); } catch { }
            
            // Skip check for login, startup, and the root path
            if (uri.Contains("/login") || uri.Contains("/startup") || string.IsNullOrEmpty(relativePath) || relativePath == "/")
                return true;

            if (!SecurityService.IsAuthenticated)
            {
                redirectTo = "/login";
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SECURITY] Error in CheckSecurity: {ex.Message}");
            return true; 
        }
        finally
        {
            if (redirectTo != null)
            {
                Navigation.NavigateTo(redirectTo);
            }
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}