@inject NavigationManager NavigationManager
@inject SecurityService SecurityService
@inject IJSRuntime JSRuntime

<div class="p-4 h-100 d-flex flex-column">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
            <i class="bi bi-journal-bookmark-fill text-white fs-5"></i>
        </div>
        <div>
            <h6 class="mb-0 fw-bold">Daily Log</h6>
            <small class="text-muted">Personal Daily Log</small>
        </div>
    </div>

    <nav class="nav nav-pills flex-column gap-2 flex-grow-1">
        <a class="nav-link d-flex align-items-center @GetActiveClass("/dashboard")" href="/dashboard">
            <i class="bi bi-speedometer2 me-3 fs-5"></i>
            <span class="fw-medium">Dashboard</span>
        </a>

        <a class="nav-link d-flex align-items-center @GetActiveClass("/entry")" href="/entry">
            <i class="bi bi-pencil-square me-3 fs-5"></i>
            <span class="fw-medium">Add New Entry</span>
        </a>

        <a class="nav-link d-flex align-items-center @GetActiveClass("/timeline")" href="/timeline">
            <i class="bi bi-graph-up me-3 fs-5"></i>
            <span class="fw-medium">Timeline</span>
        </a>

        <a class="nav-link d-flex align-items-center @GetActiveClass("/calendar")" href="/calendar">
            <i class="bi bi-calendar-date me-3 fs-5"></i>
            <span class="fw-medium">Calendar</span>
        </a>

        <a class="nav-link d-flex align-items-center @GetActiveClass("/search")" href="/search">
            <i class="bi bi-search me-3 fs-5"></i>
            <span class="fw-medium">Search</span>
        </a>

        <div class="mt-auto pt-3 border-top">
            <a class="nav-link d-flex align-items-center @GetActiveClass("/settings")" href="/settings">
                <i class="bi bi-gear me-3 fs-5"></i>
                <span class="fw-medium">Settings</span>
            </a>

            <button class="nav-link d-flex align-items-center text-danger border-0 bg-transparent w-100" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-3 fs-5"></i>
                <span class="fw-medium">Logout</span>
            </button>
        </div>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
    }

    private string GetActiveClass(string href)
    {
        return NavigationManager.Uri.Contains(href) ? "active bg-primary text-white" : "text-dark";
    }

    private async Task HandleLogout()
    {
        SecurityService.Logout();
        
        // Check if PIN protection is enabled
        var isProtected = await SecurityService.IsProtectedAsync();
        
        if (isProtected)
        {
            // If PIN is set, go to login page
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            // If no PIN, just go back to dashboard
            NavigationManager.NavigateTo("/dashboard");
        }
    }
}