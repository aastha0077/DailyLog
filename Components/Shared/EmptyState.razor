<div class="text-center py-4">
    <i class="bi bi-@Icon text-muted fs-1 mb-3"></i>
    <p class="text-muted mb-0">@Message</p>
    @if (!string.IsNullOrEmpty(ActionText))
    {
        <button class="btn btn-primary mt-3" @onclick="OnActionClick">
            @ActionText
        </button>
    }
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "inbox";

    [Parameter]
    public string Message { get; set; } = "No data available";

    [Parameter]
    public string ActionText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnActionClick { get; set; }
}
